{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "SmartLibraryDb",
    "StudentsCollection": "Students",
    "AttendanceCollection": "Attendance",
    "LibrarySettingsCollection": "LibrarySettings",
    "BooksCollection": "Books",
    "BookLoansCollection": "BookLoans"
  },
  "JwtSettings": {
    "Secret": "REPLACE_THIS_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "SmartLibraryApi",
    "Audience": "SmartLibraryClient",
    "ExpiryMinutes": 120
  },
  "AdminCredentials": {
    "Username": "admin",
    "Password": "REPLACE_THIS_IN_appsettings.Secrets.json" 
  },
  "QrSettings": {
    "Secret": "REPLACE_THIS_WITH_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "WindowSeconds": 30
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:5173"
  }
}
